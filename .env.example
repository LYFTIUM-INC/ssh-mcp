# Core
NODE_ENV=production
LOG_LEVEL=info

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring
PROMETHEUS_PORT=3001
MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL=10000

# Servers (examples)
MY_SERVER_HOST=example.com
MY_SERVER_PORT=22
MY_SERVER_USERNAME=myuser
MY_SERVER_PASSWORD=
MY_SERVER_DEFAULT_DIR=/home/myuser
MY_SERVER_DESCRIPTION=Example server

OPTINAMPOUT_HOST=example.com
OPTINAMPOUT_PORT=22
OPTINAMPOUT_USERNAME=optinamp
OPTINAMPOUT_PASSWORD=
OPTINAMPOUT_DEFAULT_DIR=/home/optinamp
OPTINAMPOUT_DESCRIPTION=Optinamp server

JOEDREAMZ_HOST=example.com
JOEDREAMZ_PORT=22
JOEDREAMZ_USERNAME=joe
JOEDREAMZ_PASSWORD=
JOEDREAMZ_DEFAULT_DIR=/home/joe
JOEDREAMZ_DESCRIPTION=JoeDreamz server